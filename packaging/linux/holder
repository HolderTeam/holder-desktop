#!/bin/sh

show_error() {
    printf '%s\n' "$1" >&2
    if command -v zenity >/dev/null 2>&1 &&
       { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        zenity --error --title='Holder could not start' --text="$1" >/dev/null 2>&1 || true
    fi
    exit 1
}

if holderctl health >/dev/null 2>&1; then
    exec holder-desktop "$@"
fi

start_error=$(systemctl --user start holder-daemon.service 2>&1) || {
    # Another instance may have become ready while systemd was trying to start.
    if holderctl health >/dev/null 2>&1; then
        exec holder-desktop "$@"
    fi
    show_error "Could not start the Holder daemon.

${start_error}

Check: systemctl --user status holder-daemon.service"
}

deadline=$(($(date +%s) + 60))
while [ "$(date +%s)" -lt "$deadline" ]; do
    if holderctl health >/dev/null 2>&1; then
        exec holder-desktop "$@"
    fi
    if systemctl --user is-failed --quiet holder-daemon.service; then
        break
    fi
    sleep 0.2
done

show_error 'The Holder daemon did not become healthy.

Check: systemctl --user status holder-daemon.service'
